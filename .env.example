# Copy this file to .env and fill in real values. Never commit .env or paste keys into chat.

# Required
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb_secret-key
# Your Google OAuth web client ID. Several can be listed, separated by commas; the first is used by the browser.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Invoice scanning (pick one)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=

# Payment reminder emails
# RESEND_API_KEY=
# RESEND_FROM=ClearRun <onboarding@resend.dev>
# CRON_SECRET=any-long-random-string
# REMINDER_TEST_TO=you@example.com   # while set, every automatic reminder goes to you, not customers
# REMINDER_LIVE=true                  # leave unset for a dry run
